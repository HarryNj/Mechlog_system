rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') || 
        request.auth.token.email == 'harrisonnjobvu@gmail.com' ||
        request.auth.token.email == 'admin@effzambia.org' ||
        request.auth.token.email == 'harrisonnjobvu@gamil.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---

    function isValidUser(data, isUpdate) {
      return (isUpdate || data.keys().hasAll(['uid', 'email', 'name', 'role'])) &&
             (!data.keys().hasAny(['uid']) || data.uid == request.auth.uid) &&
             (!data.keys().hasAny(['role']) || data.role in ['admin', 'user']);
    }

    function isValidBike(data) {
      return data.keys().hasAll(['regNo', 'province', 'district', 'model', 'officer', 'dateAdded']) &&
             data.regNo is string && data.regNo.size() <= 20 &&
             data.province is string &&
             data.district is string &&
             data.model is string &&
             data.officer is string;
    }

    function isValidSpare(data) {
      return data.keys().hasAll(['name', 'quantity', 'unitPrice', 'dateAdded', 'addedBy']) &&
             data.name is string && data.name.size() <= 100 &&
             data.quantity is int &&
             data.unitPrice is int &&
             data.dateAdded is string;
    }

    function isValidServiceLog(data) {
      return data.keys().hasAll(['bikeId', 'date', 'mileage', 'officer', 'province', 'district', 'status']) &&
             data.bikeId is int &&
             data.date is string &&
             data.mileage is int &&
             data.status in ['done', 'pending'];
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['bikeId', 'bikeReg', 'requestedBy', 'serviceType', 'problemDescription', 'status', 'dateRequested']) &&
             data.bikeId is int &&
             data.bikeReg is string &&
             data.requestedBy is string &&
             data.serviceType is string &&
             data.problemDescription is string &&
             data.status in ['pending', 'done', 'cancelled'];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming(), false);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming(), true);
      allow delete: if isAdmin();
    }

    match /bikes/{bikeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidBike(incoming());
    }

    match /spares/{spareId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidSpare(incoming());
    }

    match /service_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidServiceLog(incoming());
    }

    match /service_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidServiceRequest(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(existing().officerUid) && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['problemDescription', 'serviceType']))
      );
      allow delete: if isAdmin();
    }
  }
}
